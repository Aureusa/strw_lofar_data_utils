# Base directory for LOFAR DR2 mosaics on the STRW cluster
DR2_BASE_DIR="/disks/paradata/shimwell/LoTSS-DR2/mosaics"
DR3_BASE_DIR="/disks/paradata/shimwell/Beyond-DR2/mosaics/LoTSS-DR3-mosaics/"

# List of RA fields in DR2 - needed for mosaic processing
RA13h_field="RA13h_field"
RA0h_field="RA0h_field"

# RMS noise level in mJy/beam (used for contour levels)
RMS="0.1"
